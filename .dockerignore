# Build artifacts that must never be copied from the host into images.
# Critically, the host `.venv` has interpreter symlinks pointing at host paths
# that do not exist in the container; copying it clobbers the clean venv that
# `uv sync` builds inside the image and leaves a broken Python interpreter.

# Python
**/.venv
**/venv
**/__pycache__
**/*.pyc
**/*.pyo
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/*.egg-info

# The voice transcription model a native dev run downloads; images fetch their own.
**/.cache

# Node / frontend
**/node_modules
frontend/dist
frontend/.e2e-artifacts

# VCS & editor / OS
.git
.gitignore
**/.DS_Store

# Runtime data (Drive files, plugins, coding-agent workspaces). A host's data must
# never ship in an image: sandboxes see the image's workspace roots.
data
backend/data

# Local secrets (never bake into an image)
.env
.env.local
**/.env.local

# Logs
**/*.log

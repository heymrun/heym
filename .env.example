# Database
# Optional override. Leave blank to auto-build from POSTGRES_* values.
DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=6543
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=heym

# Credential encryption key (REQUIRED - auto-generated by run.sh/deploy.sh, or set manually)
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=

# JWT Authentication (REQUIRED - must be a cryptographically random value, min 32 chars)
# Generate one: python -c 'import secrets; print(secrets.token_urlsafe(32))'
SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Backend
BACKEND_PORT=10105
ALLOW_REGISTER=true
DOCKER_LOGS_ENABLED=false
DOCKER_LOGS_ALLOWED_EMAILS=
# Plugins (custom nodes installed as zip). Disabled by default. Install/uninstall
# runs server-side code, so it is restricted to the operator emails below.
HEYM_PLUGINS_ENABLED=false
HEYM_PLUGIN_ADMIN_EMAILS=
HEYM_PLUGINS_DIR=data/plugins
# Custom Playwright code (the `playwrightCode` field) is arbitrary Python. Off by default.
# When enabled, it runs in a hardened, throwaway sibling container (no docker socket, no
# backend mounts, no backend secrets), not in the backend process. Step-based Playwright
# nodes are unaffected and always available.
HEYM_PLAYWRIGHT_CUSTOM_CODE_ENABLED=false
# Sandbox backend for custom Playwright code:
#   auto       - require a Docker sibling container and fail closed if unavailable
#                (recommended for servers). run.sh sets this to subprocess for
#                native local dev when no image is configured.
#   docker     - same as auto but never falls back.
#   subprocess - in-process. NOT a security boundary; trusted / local dev only.
HEYM_PLAYWRIGHT_SANDBOX=auto
# Image for the Docker sandbox. Empty = auto-detect the running backend container
# image. For native run.sh without a container, either leave sandbox on auto
# (run.sh uses subprocess) or set this to heym-backend:local after building it.
HEYM_PLAYWRIGHT_SANDBOX_IMAGE=
REQUEST_BODY_MAX_SIZE_MB=100
TIMEZONE=Europe/Berlin

# Single-image runtime defaults
BACKEND_BIND_HOST=127.0.0.1
BACKEND_PROXY_HOST=127.0.0.1
AUTO_REWRITE_LOCAL_DATABASE_HOST=true

# Frontend
FRONTEND_PORT=4017
FRONTEND_URL=http://localhost:4017  # pragma: allowlist secret

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:4017  # pragma: allowlist secret

# Python tool sandbox (user-defined Agent Python tools run as untrusted code)
#   auto       - run each tool in a hardened, throwaway Docker container and fail
#                closed if Docker is unavailable (recommended for servers).
#   docker     - same as auto but never falls back.
#   subprocess - run in a local subprocess. NOT a security boundary; only for
#                trusted code / local development (run.sh sets this for native dev).
HEYM_PYTHON_TOOL_SANDBOX=auto
# Image used for the Docker sandbox. Empty = auto-detect the running backend image.
HEYM_PYTHON_TOOL_IMAGE=

# MCP stdio sandbox. Runs caller-supplied stdio commands in a hardened throwaway
# container. Separate from HEYM_PYTHON_TOOL_SANDBOX above.
#   auto/docker - Docker sandbox, fail-closed.
#   subprocess  - runs on the backend host. NOT a security boundary.
HEYM_MCP_STDIO_SANDBOX=auto
# Empty = deployment default (Compose and the GHCR image both set it).
HEYM_MCP_STDIO_IMAGE=
# No Heym storage reaches MCP servers unless you name a volume or host dir here.
HEYM_MCP_STDIO_FILES_VOLUME=
HEYM_MCP_STDIO_FILES_SUBPATH=
HEYM_MCP_STDIO_FILES_HOST_DIR=
HEYM_MCP_STDIO_FILES_WRITABLE=false
HEYM_MCP_STDIO_TMPFS_SIZE=512m
HEYM_MCP_STDIO_MEMORY=512m
HEYM_MCP_STDIO_CPUS=2
HEYM_MCP_STDIO_PIDS=256

# MCP egress guard (SSRF protection). When false (default), sse/streamable_http
# MCP servers must resolve to a public address; loopback, private, link-local,
# and cloud-metadata targets are refused. Set true only on trusted self-hosted
# instances that intentionally connect to internal MCP servers.
HEYM_MCP_ALLOW_PRIVATE_URLS=false

# OpenTelemetry tracing (optional, disabled by default)
# When enabled, Heym emits workflow/node spans and Agent tool spans
# over OTLP/HTTP. See docs: Reference > OpenTelemetry Tracing.
HEYM_OTEL_ENABLED=false
HEYM_OTEL_EXPORTER_OTLP_ENDPOINT=
HEYM_OTEL_EXPORTER_OTLP_HEADERS=
HEYM_OTEL_SERVICE_NAME=heym
HEYM_OTEL_TRACES_SAMPLER_RATIO=1.0
HEYM_OTEL_CAPTURE_NODE_IO=false

# Codex / OpenCode sibling runner resource limits (Docker deployments via deploy.sh)
# Defaults match docker/heym-*-docker wrappers (2 CPU / 4g). Override in .env as needed.
HEYM_CODEX_DOCKER_CPUS=2
HEYM_CODEX_DOCKER_MEMORY=4g
HEYM_OPENCODE_DOCKER_CPUS=2
HEYM_OPENCODE_DOCKER_MEMORY=4g

# Load distribution across instances sharing this database.
# Every instance must use the same SECRET_KEY and ENCRYPTION_KEY, and ingress
# must point at the main instance only. See ENVIRONMENT-VARIABLES.md.
HEYM_CLUSTER_ENABLED=false
HEYM_INSTANCE_ROLE=main
HEYM_INSTANCE_NAME=
HEYM_INSTANCE_ID=
